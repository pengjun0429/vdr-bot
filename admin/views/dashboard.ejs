<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VDR 政府服務機器人 - 控制臺</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif; background:#0f1a2e; color:#e4e4e7; min-height:100vh; }
    body::before { content:''; position:fixed; top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(ellipse at 20% 30%, rgba(201,168,76,0.04) 0%, transparent 50%);pointer-events:none;z-index:0; }

    .nav { position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center;padding:14px 40px;background:rgba(15,26,46,0.9);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,0.05); }
    .nav .logo { font-size:16px;font-weight:800;color:#fff;text-decoration:none; }
    .nav .logo span { color:#c9a84c; }
    .nav .right { display:flex;align-items:center;gap:16px; }
    .nav .right .status { font-size:12px;color:#8b826e;display:flex;align-items:center;gap:4px; }
    .nav .right .status .dot { width:6px;height:6px;border-radius:50%; }
    .nav .right .status .dot.on { background:#22c55e; }
    .nav .right .status .dot.off { background:#ef4444; }
    .nav .right a { color:#8b826e;text-decoration:none;font-size:13px;transition:color 0.15s; }
    .nav .right a:hover { color:#fff; }

    .hero { position:relative;z-index:1;text-align:center;padding:40px 20px 20px; }
    .hero h1 { font-size:22px;font-weight:700;color:#fff;margin-bottom:4px; }
    .hero p { color:#8b826e;font-size:13px; }

    .stats { position:relative;z-index:1;display:flex;gap:10px;justify-content:center;padding:0 40px 24px;max-width:800px;margin:0 auto;flex-wrap:wrap; }
    .stat { flex:1;min-width:120px;background:rgba(24,24,27,0.5);border:1px solid rgba(255,255,255,0.04);border-radius:8px;padding:16px;text-align:center; }
    .stat .num { font-size:24px;font-weight:700;color:#fff; }
    .stat .label { font-size:10px;color:#8b826e;margin-top:2px;text-transform:uppercase;letter-spacing:0.5px; }

    .vdr-link { position:relative;z-index:1;text-align:center;padding:0 40px 40px; }
    .vdr-link a { display:inline-block;padding:10px 24px;background:#c9a84c;color:#0f1a2e;border-radius:6px;font-weight:600;text-decoration:none;font-size:14px; }
    .vdr-link a:hover { background:#dcc060; }
  </style>
</head>
<body>
  <div class="nav">
    <a href="/" class="logo">虛境<span>民主共和國</span></a>
    <div class="right">
      <span class="status"><span class="dot on"></span>在線</span>
      <a href="/logout">登出</a>
    </div>
  </div>

  <div class="hero">
    <h1>國家管理控制臺</h1>
    <p><%= commands %> 個指令 · 延遲 <%= ping %>ms</p>
  </div>

  <div class="stats">
    <div class="stat"><div class="num"><%= vdrStats.citizens %></div><div class="label">公民</div></div>
    <div class="stat"><div class="num"><%= vdrStats.decrees %></div><div class="label">總統令</div></div>
    <div class="stat"><div class="num"><%= vdrStats.allies %></div><div class="label">邦交國</div></div>
    <div class="stat"><div class="num"><%= vdrStats.treasury.toLocaleString() %></div><div class="label">國庫</div></div>
    <div class="stat"><div class="num"><%= vdrStats.transactions %></div><div class="label">交易</div></div>
    <div class="stat"><div class="num"><%= ping %>ms</div><div class="label">延遲</div></div>
  </div>

  <div class="vdr-link">
    <a href="/vdr">📊 國家資料儀表板</a>
  </div>
</body>
</html>
