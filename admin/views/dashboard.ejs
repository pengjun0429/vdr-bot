<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VDR 政府服務機器人 - 控制臺</title>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    body { font-family:'Inter',-apple-system,BlinkMacSystemFont,'Noto Sans TC',sans-serif; background:#f4f2ed; color:#1e1e2a; }
    .nav { display:flex;justify-content:space-between;align-items:center;padding:12px 32px;background:#0f1a2e;border-bottom:1px solid rgba(255,255,255,0.05); }
    .nav .logo { font-size:15px;font-weight:700;color:#e8d5a3;text-decoration:none; }
    .nav .right { display:flex;align-items:center;gap:14px; }
    .nav .right .dot { width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:4px; }
    .nav .right .dot.on { background:#22c55e; }
    .nav .right a { color:#8b826e;text-decoration:none;font-size:13px; }
    .nav .right a:hover { color:#e8d5a3; }
    .container { max-width:900px;margin:0 auto;padding:24px 16px 40px; }

    .hero { text-align:center;padding:20px 0; }
    .hero h1 { font-size:20px;font-weight:700;color:#0f1a2e; }
    .hero p { font-size:13px;color:#8b826e;margin-top:4px; }

    .stats { display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0; }
    .stat { background:#fff;border-radius:6px;padding:16px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,0.04);border:1px solid #e0ddd6; }
    .stat .num { font-size:22px;font-weight:700;color:#0f1a2e; }
    .stat .label { font-size:11px;color:#8b826e;margin-top:2px; }

    .quick { display:flex;gap:8px;margin:16px 0;flex-wrap:wrap; }
    .quick a { flex:1;min-width:120px;background:#fff;border:1px solid #e0ddd6;border-radius:6px;padding:12px 14px;text-align:center;text-decoration:none;font-size:13px;font-weight:500;color:#0f1a2e;transition:0.15s;box-shadow:0 1px 4px rgba(0,0,0,0.04); }
    .quick a:hover { border-color:#c9a84c;background:#faf8f3; }

    .section { background:#fff;border-radius:6px;padding:20px 24px;margin:16px 0;box-shadow:0 1px 4px rgba(0,0,0,0.04);border:1px solid #e0ddd6; }
    .section h2 { font-size:15px;font-weight:600;color:#0f1a2e;margin-bottom:12px;padding-bottom:6px;border-bottom:2px solid #dcc89a; }
    table { width:100%;border-collapse:collapse;font-size:13px; }
    th,td { border:1px solid #e0ddd6;padding:6px 10px;text-align:left; }
    th { background:#0f1a2e;color:#fff;font-weight:600;font-size:12px; }
    tr:nth-child(even) td { background:#faf9f6; }
    .empty { color:#8b826e;padding:20px;text-align:center; }

    @media (max-width:540px) {
      .stats { grid-template-columns:1fr 1fr; }
      .quick a { min-width:80px;font-size:12px; }
      .nav { padding:10px 16px; }
    }
  </style>
</head>
<body>
  <div class="nav">
    <a href="/" class="logo">虛境民主共和國 ｜ 管理後臺</a>
    <div class="right">
      <span class="dot on"></span>在線
      <a href="/vdr">📊 國家資料</a>
      <a href="/logout">登出</a>
    </div>
  </div>

  <div class="container">
    <div class="hero">
      <h1>國家管理控制臺</h1>
      <p><%= commands %> 個指令 · 延遲 <%= ping %>ms</p>
    </div>

    <div class="stats">
      <div class="stat"><div class="num"><%= vdrStats.citizens %></div><div class="label">公民</div></div>
      <div class="stat"><div class="num"><%= vdrStats.decrees %></div><div class="label">總統令</div></div>
      <div class="stat"><div class="num"><%= vdrStats.allies %></div><div class="label">邦交國</div></div>
      <div class="stat"><div class="num"><%= vdrStats.announcements %></div><div class="label">公告</div></div>
      <div class="stat"><div class="num"><%= Number(vdrStats.treasury).toLocaleString() %></div><div class="label">國庫（幣）</div></div>
      <div class="stat"><div class="num"><%= vdrStats.transactions %></div><div class="label">交易筆數</div></div>
    </div>

    <div class="quick">
      <a href="/vdr">📊 完整資料儀表板</a>
    </div>

    <div class="section">
      <h2>最新公民</h2>
      <% if (vdrStats.recentCitizens.length === 0) { %><div class="empty">尚無註冊公民</div><% } %>
      <% if (vdrStats.recentCitizens.length > 0) { %>
      <table>
        <tr><th>名稱</th><th>行政區</th><th>錢包</th><th>註冊時間</th></tr>
        <% for (const c of vdrStats.recentCitizens) { %>
        <tr>
          <td><%= c.name %></td>
          <td><%= c.region %></td>
          <td><%= c.wallet %></td>
          <td><%= new Date(c.registeredAt).toLocaleString('zh-TW') %></td>
        </tr>
        <% } %>
      </table>
      <% } %>
    </div>
  </div>
</body>
</html>
