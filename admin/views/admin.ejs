<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle %> | VDR 蝞∠?敺</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Noto Sans TC',sans-serif;background:#f4f2ed;color:#1e1e2a;display:flex;min-height:100vh}

/* Sidebar */
.sidebar{width:220px;background:#0f1a2e;color:#e8d5a3;display:flex;flex-direction:column;flex-shrink:0}
.sidebar .title{padding:20px 18px;font-size:14px;font-weight:700;border-bottom:1px solid rgba(255,255,255,0.05);letter-spacing:0.5px}
.sidebar .title span{color:#c9a84c}
.sidebar nav{padding:8px 0;flex:1}
.sidebar nav a{display:flex;align-items:center;gap:8px;padding:10px 18px;color:#8b826e;text-decoration:none;font-size:13px;transition:0.12s}
.sidebar nav a:hover{color:#e8d5a3;background:rgba(255,255,255,0.03)}
.sidebar nav a.active{color:#e8d5a3;background:rgba(201,168,76,0.08);border-right:3px solid #c9a84c}
.sidebar .footer{padding:14px 18px;border-top:1px solid rgba(255,255,255,0.05);font-size:11px;color:#5a5240}

/* Main */
.main{flex:1;display:flex;flex-direction:column;min-width:0}
.topbar{display:flex;justify-content:space-between;align-items:center;padding:12px 28px;background:#fff;border-bottom:1px solid #e0ddd6}
.topbar .bread{font-size:13px;color:#8b826e}
.topbar .bread strong{color:#0f1a2e}
.topbar .status{font-size:12px;display:flex;align-items:center;gap:4px;color:#8b826e}
.topbar .status .dot{width:7px;height:7px;border-radius:50%;display:inline-block}
.topbar .status .dot.on{background:#22c55e}
.content{padding:24px 28px 40px;flex:1}

.card{background:#fff;border-radius:6px;padding:20px 24px;margin-bottom:16px;box-shadow:0 1px 4px rgba(0,0,0,0.04);border:1px solid #e0ddd6}
.card h2{font-size:15px;font-weight:600;color:#0f1a2e;margin-bottom:12px;padding-bottom:6px;border-bottom:2px solid #dcc89a;display:flex;align-items:center;gap:8px}
.card h2 .count{font-size:12px;color:#8b826e;font-weight:400}

.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:0 0 16px}
.stat-box{background:#fff;border:1px solid #e0ddd6;border-radius:6px;padding:16px;text-align:center;box-shadow:0 1px 4px rgba(0,0,0,0.04)}
.stat-box .num{font-size:24px;font-weight:700;color:#0f1a2e}
.stat-box .label{font-size:10px;color:#8b826e;margin-top:2px;text-transform:uppercase;letter-spacing:0.5px}

table{width:100%;border-collapse:collapse;font-size:13px}
th,td{border:1px solid #e0ddd6;padding:6px 10px;text-align:left}
th{background:#0f1a2e;color:#fff;font-weight:600;font-size:11px;white-space:nowrap}
tr:nth-child(even) td{background:#faf9f6}
.badge{display:inline-block;padding:1px 8px;border-radius:10px;font-size:11px;background:#dcc89a;color:#0f1a2e}
.empty{color:#8b826e;padding:30px;text-align:center;font-size:13px}

input,select,textarea{padding:7px 10px;border:1px solid #e0ddd6;border-radius:4px;font-size:13px;outline:none;width:100%}
input:focus,select:focus,textarea:focus{border-color:#c9a84c}
textarea{resize:vertical;min-height:60px;font-family:inherit}
.form-group{margin-bottom:12px}
.form-group label{display:block;font-size:12px;font-weight:600;color:#555;margin-bottom:3px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}

.btn{display:inline-flex;align-items:center;gap:4px;padding:7px 16px;border-radius:4px;font-size:12px;font-weight:600;border:none;cursor:pointer;text-decoration:none;transition:0.12s}
.btn-gold{background:#c9a84c;color:#0f1a2e}
.btn-gold:hover{background:#dcc060}
.btn-sm{padding:4px 10px;font-size:11px}
.btn-danger{background:#dc2626;color:#fff}
.btn-danger:hover{background:#b91c1c}
.btn-outline{background:transparent;border:1px solid #e0ddd6;color:#555}
.btn-outline:hover{border-color:#c9a84c}

.alert{padding:10px 14px;border-radius:4px;font-size:13px;margin-bottom:12px;display:none}
.alert-success{background:#dcfce7;color:#166534;border:1px solid #bbf7d0;display:block}
.alert-error{background:#fee2e2;color:#991b1b;border:1px solid #fecaca;display:block}

.search-bar{display:flex;gap:8px;margin-bottom:12px}
.search-bar input{flex:1}

@media(max-width:768px){
  .sidebar{width:60px}
  .sidebar .title,.sidebar nav a span,.sidebar .footer{display:none}
  .sidebar nav a{padding:12px;justify-content:center}
  .content{padding:16px}
  .form-row{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="sidebar">
  <div class="title">??<span>?勗???/span></div>
  <nav>
    <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">?? <span>?批??/span></a>
    <a href="/admin/citizens" class="<%= page === 'citizens' ? 'active' : '' %>">? <span>?祆?蝞∠?</span></a>
    <a href="/admin/decrees" class="<%= page === 'decrees' ? 'active' : '' %>">?? <span>蝮賜絞隞?/span></a>
    <a href="/admin/announce" class="<%= page === 'announce' ? 'active' : '' %>">? <span>?振?砍?</span></a>
    <a href="/admin/economy" class="<%= page === 'economy' ? 'active' : '' %>">? <span>蝬?蝞∠?</span></a>
    <a href="/admin/diplomacy" class="<%= page === 'diplomacy' ? 'active' : '' %>">?? <span>憭漱?虫漱</span></a>
    <a href="/admin/roles" class="<%= page === 'roles' ? 'active' : '' %>">? <span>頨怠?蝯恣??/span></a>
    <a href="/admin/autorole" class="<%= page === 'autorole' ? 'active' : '' %>">?? <span>?芸?頨怠?蝯?/span></a>
    <a href="/admin/welcome" class="<%= page === 'welcome' ? 'active' : '' %>">?? <span>甇∟?閮剖?</span></a>
    <a href="/admin/servers" class="<%= page === 'servers' ? 'active' : '' %>">?儭?<span>隡箸???/span></a>
    <a href="/admin/logs" class="<%= page === 'logs' ? 'active' : '' %>">?? <span>蝟餌絞?亥?</span></a>
  </nav>
  <div class="footer">v<%= version %> | <a href="/logout" style="color:#8b826e;text-decoration:none">?餃</a></div>
</div>

<div class="main">
  <div class="topbar">
    <div class="bread"><strong><%= pageTitle %></strong></div>
    <div class="status"><span class="dot on"></span> ?函? 繚 <%= ping %>ms</div>
  </div>
  <div class="content">

    <!-- ===================== DASHBOARD ===================== -->
    <% if (page === 'dashboard') { %>
    <div class="stats">
      <div class="stat-box"><div class="num"><%= d.citizens %></div><div class="label">?祆?</div></div>
      <div class="stat-box"><div class="num"><%= d.decrees %></div><div class="label">蝮賜絞隞?/div></div>
      <div class="stat-box"><div class="num"><%= d.announcements %></div><div class="label">?砍?</div></div>
      <div class="stat-box"><div class="num"><%= d.allies %></div><div class="label">?虫漱??/div></div>
      <div class="stat-box"><div class="num"><%= Number(d.treasury).toLocaleString() %></div><div class="label">?澈</div></div>
      <div class="stat-box"><div class="num"><%= d.txCount %></div><div class="label">鈭斗?</div></div>
      <div class="stat-box"><div class="num"><%= d.servers %></div><div class="label">隡箸???/div></div>
      <div class="stat-box"><div class="num"><%= d.regions %></div><div class="label">銵?</div></div>
    </div>
    <div class="card">
      <h2>??唳暑??/h2>
      <% if (d.recent.length === 0) { %><div class="empty">撠瘣餃?蝝??/div><% } %>
      <% if (d.recent.length > 0) { %>
      <table>
        <tr><th>??</th><th>憿?</th><th>?批捆</th></tr>
        <% for (const r of d.recent) { %>
        <tr><td style="font-size:11px"><%= r.time %></td><td><span class="badge"><%= r.type %></span></td><td><%= r.text %></td></tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== CITIZENS ===================== -->
    <% if (page === 'citizens') { %>
    <div class="card">
      <h2>?祆??” <span class="count"><%= citizens.length %> 鈭?/span></h2>
      <div class="search-bar">
        <input type="text" id="searchInput" placeholder="???迂?D..." onkeyup="filterTable(this.value)">
      </div>
      <% if (citizens.length === 0) { %><div class="empty">撠閮餃??祆?</div><% } %>
      <% if (citizens.length > 0) { %>
      <table id="dataTable">
        <tr><th>ID</th><th>?迂</th><th>銵?</th><th>?Ｗ?</th><th>閮餃???</th></tr>
        <% for (const c of citizens) { %>
        <tr>
          <td style="font-size:11px;color:#8b826e"><%= c.id %></td>
          <td><strong><%= c.name %></strong></td>
          <td><span class="badge"><%= c.region %></span></td>
          <td><%= c.wallet %></td>
          <td style="font-size:11px"><%= new Date(c.registeredAt).toLocaleString('zh-TW') %></td>
        </tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== DECREES ===================== -->
    <% if (page === 'decrees') { %>
    <% if (alert) { %><div class="alert alert-<%= alert.type %>"><%= alert.text %></div><% } %>
    <div class="card">
      <h2>?澆?蝮賜絞隞?/h2>
      <form method="POST" action="/admin/decrees/create">
        <div class="form-row">
          <div class="form-group"><label>璅?</label><input name="title" required></div>
          <div class="form-group"><label>?潮?駁?嚗憛恬?</label>
            <select name="channelId">
              <option value=""> -- 銝??--</option>
              <% for (const ch of channels) { %>
              <option value="<%= ch.id %>"><%= ch.name %></option>
              <% } %>
            </select>
          </div>
        </div>
        <div class="form-group"><label>?批捆</label><textarea name="content" rows="4" required></textarea></div>
        <button class="btn btn-gold" type="submit">?? ?澆?蝮賜絞隞?/button>
      </form>
    </div>
    <div class="card">
      <h2>蝮賜絞隞文?銵?<span class="count"><%= decrees.length %> 蝑?/span></h2>
      <% if (decrees.length === 0) { %><div class="empty">撠蝮賜絞隞?/div><% } %>
      <% if (decrees.length > 0) { %>
      <table>
        <tr><th>#</th><th>璅?</th><th>?澆???/th><th>??</th></tr>
        <% for (const d of decrees) { %>
        <tr><td><%= d.id %></td><td><strong><%= d.title %></strong></td><td><%= d.authorName %></td><td style="font-size:11px"><%= new Date(d.issuedAt).toLocaleString('zh-TW') %></td></tr>
        <tr style="background:#f8f6f1"><td colspan="4" style="font-size:12px;color:#555;padding:8px 12px"><%= d.content %></td></tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== ANNOUNCE ===================== -->
    <% if (page === 'announce') { %>
    <% if (alert) { %><div class="alert alert-<%= alert.type %>"><%= alert.text %></div><% } %>
    <div class="card">
      <h2>?澆??砍?</h2>
      <div style="background:#f8f6f1;border:1px solid #e0ddd6;border-radius:4px;padding:10px 14px;margin-bottom:14px;font-size:13px">
        ?喳??澆?蝺刻?嚗?strong style="color:#0f1a2e">??摮洵 <%= nextNumber %> ??/strong>
      </div>
      <form method="POST" action="/admin/announce/send">
        <div class="form-row">
          <div class="form-group"><label>璅?</label><input name="title" required></div>
          <div class="form-group"><label>?澆??桐?</label><input name="unit" placeholder="?銵撅" value="?銵撅"></div>
        </div>
        <div class="form-group"><label>?批捆</label><textarea name="content" rows="4" required></textarea></div>
        <div class="form-group"><label>?潮</label>
          <select name="channelId" required>
            <option value="">-- ?豢??駁? --</option>
            <% for (const ch of channels) { %>
            <option value="<%= ch.id %>"><%= ch.name %></option>
            <% } %>
          </select>
        </div>
        <button class="btn btn-gold" type="submit">? ?澆??砍?</button>
      </form>
    </div>
    <div class="card">
      <h2>?砍?蝝??<span class="count"><%= announcements.length %> 蝑?/span></h2>
      <% if (announcements.length === 0) { %><div class="empty">撠?砍?</div><% } %>
      <% if (announcements.length > 0) { %>
      <table>
        <tr><th>蝺刻?</th><th>璅?</th><th>?澆???/th><th>??</th></tr>
        <% for (const a of announcements) { %>
        <tr><td style="font-size:11px"><%= a.number %></td><td><strong><%= a.title %></strong></td><td><%= a.author %></td><td style="font-size:11px"><%= new Date(a.at).toLocaleString('zh-TW') %></td></tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== ECONOMY ===================== -->
    <% if (page === 'economy') { %>
    <div class="stats">
      <div class="stat-box"><div class="num"><%= Number(treasury).toLocaleString() %></div><div class="label">?澈蝮賡?</div></div>
      <div class="stat-box"><div class="num"><%= Number(totalSupply).toLocaleString() %></div><div class="label">蝮賣???</div></div>
      <div class="stat-box"><div class="num"><%= txCount %></div><div class="label">鈭斗?蝑</div></div>
    </div>
    <div class="card">
      <h2>鈭斗?蝝??/h2>
      <% if (txs.length === 0) { %><div class="empty">撠鈭斗?</div><% } %>
      <% if (txs.length > 0) { %>
      <table>
        <tr><th>??</th><th>頧</th><th>頧</th><th>??</th><th>?酉</th></tr>
        <% for (const t of txs) { %>
        <tr><td style="font-size:11px"><%= new Date(t.at).toLocaleString('zh-TW') %></td><td style="font-size:11px"><%= t.from %></td><td style="font-size:11px"><%= t.to %></td><td><strong><%= t.amount %></strong></td><td style="color:#8b826e"><%= t.note || '-' %></td></tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== DIPLOMACY ===================== -->
    <% if (page === 'diplomacy') { %>
    <% if (alert) { %><div class="alert alert-<%= alert.type %>"><%= alert.text %></div><% } %>
    <div class="card">
      <h2>?啣??虫漱??/h2>
      <form method="POST" action="/admin/diplomacy/add" style="display:flex;gap:8px;flex-wrap:wrap">
        <input name="name" placeholder="?振?迂" required style="flex:2;min-width:140px">
        <input name="date" placeholder="撱箔漱?交?嚗憛恬?" style="flex:1;min-width:120px">
        <button class="btn btn-gold" type="submit">嚗??啣?</button>
      </form>
    </div>
    <div class="card">
      <h2>?虫漱??<span class="count"><%= allies.length %> ??/span></h2>
      <% if (allies.length === 0) { %><div class="empty">撠?虫漱??/div><% } %>
      <% if (allies.length > 0) { %>
      <table>
        <tr><th>?振?迂</th><th>撱箔漱?交?</th><th style="width:60px">??</th></tr>
        <% for (const a of allies) { %>
        <tr>
          <td><strong><%= a.name %></strong></td>
          <td><%= a.date || '-' %></td>
          <td>
            <form method="POST" action="/admin/diplomacy/remove" onsubmit="return confirm('蝣箏?蝘駁 <%= a.name %>嚗?)">
              <input type="hidden" name="name" value="<%= a.name %>">
              <button class="btn btn-sm btn-danger" type="submit">蝘駁</button>
            </form>
          </td>
        </tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <div class="card">
      <h2>??蝯?</h2>
      <% if (orgs.length === 0) { %><div class="empty">撠???蝯?</div><% } %>
      <% if (orgs.length > 0) { %>
      <table>
        <tr><th>蝯??迂</th><th>??交?</th></tr>
        <% for (const o of orgs) { %>
        <tr><td><strong><%= o.name %></strong></td><td><%= o.joined %></td></tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== SERVERS ===================== -->
    <% if (page === 'roles') { %>
    <% if (alert) { %><div class="alert alert-<%= alert.type %>"><%= alert.text %></div><% } %>
    <div class="card">
      <h2>?晷頨怠?蝯策?</h2>
      <form method="POST" action="/admin/roles/assign" style="display:flex;gap:8px;flex-wrap:wrap">
        <select name="roleId" required style="flex:1;min-width:140px">
          <option value="">-- ?豢?頨怠?蝯?--</option>
          <% for (const r of roles) { %>
          <option value="<%= r.id %>" style="<%= r.color ? 'color:'+r.color : '' %>"><%= r.name %>嚗?%= r.guild %>嚗?/option>
          <% } %>
        </select>
        <input name="userId" placeholder="Discord 雿輻??ID" required style="flex:1;min-width:140px">
        <button class="btn btn-gold" type="submit" name="action" value="add">嚗??啣?</button>
        <button class="btn btn-danger" type="submit" name="action" value="remove">嚗?蝘駁</button>
      </form>
    </div>
    <div class="card">
      <h2>頨怠?蝯??惜蝝?<span class="count">?梢??喃???</span></h2>
      <p style="font-size:12px;color:#8b826e;margin-bottom:10px">甈?頞??頞??ｇ??臭誑蝞∠?銝?澈????/p>
      <% if (roles.length === 0) { %><div class="empty">?∟澈??鞈?</div><% } %>
      <% if (roles.length > 0) { %>
      <table>
        <tr><th style="width:40px">#</th><th>?迂</th><th>ID</th><th>憿</th><th>鈭箸</th><th>隡箸???/th></tr>
        <% for (let i = 0; i < roles.length; i++) { %>
        <tr>
          <td style="text-align:center;font-weight:700;color:<%= i < 3 ? '#c9a84c' : '#8b826e' %>"><%= i + 1 %></td>
          <td><span style="<%= roles[i].color ? 'color:'+roles[i].color : '' %>;font-weight:600"><%= roles[i].name %></span></td>
          <td style="font-size:11px;color:#8b826e"><%= roles[i].id %></td>
          <td><span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:<%= roles[i].color || '#999' %>;vertical-align:middle"></span></td>
          <td><%= roles[i].count %> 鈭?/td>
          <td><%= roles[i].guild %></td>
        </tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <div class="card">
      <h2>蝞∠??∟澈??</h2>
      <p style="font-size:12px;color:#8b826e;margin-bottom:10px">隞乩?頨怠?蝯??恣???箏?????/p>
      <table>
        <tr><th>?迂</th><th>ID</th><th>??</th></tr>
        <% for (let i = 0; i < roles.length; i++) { %>
        <% if (adminRoleIds.includes(roles[i].id)) { %>
        <tr>
          <td><span style="<%= roles[i].color ? 'color:'+roles[i].color : '' %>;font-weight:600"><%= roles[i].name %></span> 潃?/td>
          <td style="font-size:11px;color:#8b826e"><%= roles[i].id %></td>
          <td>#<%= i + 1 %></td>
        </tr>
        <% } %>
        <% } %>
        <% if (adminRoleIds.filter(x => x).length === 0) { %><tr><td colspan="3" style="color:#8b826e">撠閮剖?蝞∠??∟澈??</td></tr><% } %>
      </table>
    </div>
    <% } %>

    <% if (page === 'autorole') { %>
    <% if (alert) { %><div class="alert alert-<%= alert.type %>"><%= alert.text %></div><% } %>
    <div class="card">
      <h2>?芸?頨怠?蝯身摰?/h2>
      <p style="font-size:13px;color:#8b826e;margin-bottom:12px">閮剖?敺頂蝯望??芸?撠澈????蝯衣泵??隞嗥????/p>
      <form method="POST" action="/admin/autorole/save">
        <div class="form-group"><label>?隡箸??冽??芸?蝯虫?</label>
          <select name="joinRoleId">
            <option value="">-- 銝策鈭?--</option>
            <% for (const r of roles) { %>
            <option value="<%= r.id %>" <%= autoRole.joinRoleId === r.id ? 'selected' : '' %>><%= r.name %>嚗?%= r.guild %>嚗?/option>
            <% } %>
          </select>
        </div>
        <div class="form-group"><label>閮餃??祆???策鈭?/label>
          <select name="citizenRoleId">
            <option value="">-- 銝策鈭?--</option>
            <% for (const r of roles) { %>
            <option value="<%= r.id %>" <%= autoRole.citizenRoleId === r.id ? 'selected' : '' %>><%= r.name %>嚗?%= r.guild %>嚗?/option>
            <% } %>
          </select>
        </div>
        <button class="btn btn-gold" type="submit">? ?脣?閮剖?</button>
      </form>
    </div>
    <% } %>

    <% if (page === 'welcome') { %>
    <% if (alert) { %><div class="alert alert-<%= alert.type %>"><%= alert.text %></div><% } %>
    <div class="card">
      <h2>甇∟?閮閮剖?</h2>
      <form method="POST" action="/admin/welcome/save">
        <div class="form-group">
          <label style="display:flex;align-items:center;gap:8px">
            <input type="checkbox" name="enabled" value="1" <%= welcome.enabled ? 'checked' : '' %> style="width:auto">
            ?甇∟?閮
          </label>
        </div>
        <div class="form-group"><label>?潮??/label>
          <select name="channelId">
            <option value="">-- 蝟餌絞?身?駁? --</option>
            <% for (const ch of channels) { %>
            <option value="<%= ch.id %>" <%= welcome.channelId === ch.id ? 'selected' : '' %>><%= ch.name %></option>
            <% } %>
          </select>
        </div>
        <div class="form-group"><label>?芸??潭頨怠?蝯??唳??∪??交??芸??脣?嚗?/label>
          <select name="autoRoleId">
            <option value="">-- 銝??--</option>
            <% for (const r of allRoles) { %>
            <option value="<%= r.id %>" <%= autoRoleId === r.id ? 'selected' : '' %>><%= r.name %></option>
            <% } %>
          </select>
        </div>
        <button class="btn btn-gold" type="submit">? ?脣?閮剖?</button>
      </form>
    </div>
    <% } %>

    <% if (page === 'servers') { %>
    <div class="card">
      <h2>撌脣??亦?隡箸???<span class="count"><%= guilds.length %> ??/span></h2>
      <% if (guilds.length === 0) { %><div class="empty">撠?隞颱?隡箸???/div><% } %>
      <% if (guilds.length > 0) { %>
      <table>
        <tr><th>?迂</th><th>ID</th><th>???/th><th>????/th></tr>
        <% for (const g of guilds) { %>
        <tr>
          <td><strong><%= g.name %></strong></td>
          <td style="font-size:11px;color:#8b826e"><%= g.id %></td>
          <td><%= g.members %></td>
          <td style="font-size:12px"><%= g.owner %></td>
        </tr>
        <% } %>
      </table>
      <% } %>
    </div>
    <% } %>

    <!-- ===================== LOGS ===================== -->
    <% if (page === 'logs') { %>
    <div style="display:flex;gap:12px;flex-wrap:wrap">
      <div style="flex:1;min-width:300px">
        <div class="card">
          <h2>蝟餌絞??蝝??/h2>
          <div style="background:#0f1a2e;color:#e8d5a3;padding:12px 16px;border-radius:4px;font-family:monospace;font-size:11px;max-height:400px;overflow-y:auto;line-height:1.6">
            <% if (systemLogs.length === 0) { %><div style="color:#5a5240">撠蝝??/div><% } %>
            <% for (const l of systemLogs) { %>
            <div style="border-bottom:1px solid rgba(255,255,255,0.03);padding:2px 0">[<%= l.time %>] <%= l.text %></div>
            <% } %>
          </div>
        </div>
      </div>
      <div style="flex:2;min-width:300px">
        <div class="card">
          <h2>閮蝝??<span class="count">???<%= messages.length %> 蝑?/span></h2>
          <div style="background:#0f1a2e;color:#e8d5a3;padding:12px 16px;border-radius:4px;font-family:monospace;font-size:11px;max-height:500px;overflow-y:auto;line-height:1.5">
            <% if (messages.length === 0) { %><div style="color:#5a5240">撠?遙雿???/div><% } %>
            <% for (const m of messages) { %>
            <div style="border-bottom:1px solid rgba(255,255,255,0.03);padding:3px 0">
              [<%= new Date(m.timestamp).toLocaleString('zh-TW') %>]
              <span style="color:<%= m.type === 'delete' ? '#ef4444' : '#e8d5a3' %>"><%= m.authorTag %></span>
              <span style="color:#8b826e">#<%= m.channelName %></span>
              <% if (m.type === 'delete') { %><span style="color:#ef4444">[撌脣?也</span><% } %>
              嚗?%= (m.content || '').slice(0, 200) %>
            </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
    <% } %>

  </div>
</div>

<script>
function filterTable(val) {
  const rows = document.getElementById('dataTable')?.querySelectorAll('tr:not(:first-child)');
  if (!rows) return;
  const lower = val.toLowerCase();
  rows.forEach(r => { r.style.display = r.textContent.toLowerCase().includes(lower) ? '' : 'none' });
}
// Auto-hide alerts
setTimeout(() => { document.querySelectorAll('.alert').forEach(el => el.style.display = 'none') }, 4000);
</script>
</body>
</html>

